# ═══════════════════════════════════════════════════════════════
# SEHAT GUFTAGU — Environment Variables
# All services marked [FREE] require no payment for development/demo
# ═══════════════════════════════════════════════════════════════

# Database - Supabase PostgreSQL Connection String
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL for Prisma migrations (without pgbouncer)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Better Auth Secret - Generate a random 32+ character string
# You can generate one at: https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET="your-super-secret-key-at-least-32-chars"

# Better Auth URL - Your app's base URL
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Credentials
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─────────────────────────────────────────────────────────────────
# AI / LLM SERVICES
# ─────────────────────────────────────────────────────────────────

# Gemini API Key [FREE — 1M tokens/day free tier]
# Used for: AI chat, clinical interviews, Gemini Vision (image analysis), 4-language support
# Get this from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Groq API Key [FREE — generous free tier]
# Used for: LLaMA 70B reasoning, Whisper STT (speech-to-text), streaming responses
# Get this from: https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"

# ─────────────────────────────────────────────────────────────────
# VOICE / TTS SERVICES
# ─────────────────────────────────────────────────────────────────

# ElevenLabs API Key [FREE tier available — 10,000 chars/month]
# Used for: Urdu voice synthesis (primary TTS)
# Get this from: https://elevenlabs.io -> Profile -> API Key
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Uplift AI API Key [FREE — Urdu TTS fallback]
# Used for: Urdu TTS fallback when ElevenLabs quota exceeded
# Get this from: https://platform.upliftai.org/studio/home
UPLIFT_API_KEY="your-uplift-api-key"

# ─────────────────────────────────────────────────────────────────
# VECTOR DATABASE (RAG)
# ─────────────────────────────────────────────────────────────────

# Pinecone API Key [FREE — 2GB storage free tier]
# Used for: Medical knowledge RAG (Hybrid BM25 + Dense search)
# Get this from: https://www.pinecone.io/
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_INDEX_NAME="medical-fast-search"

# ─────────────────────────────────────────────────────────────────
# REAL-TIME COMMUNICATION
# ─────────────────────────────────────────────────────────────────

# LiveKit Configuration [FREE — 10,000 min/month free tier]
# Used for: Telemedicine video consultation
# Get these from: https://cloud.livekit.io
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_WS_URL="wss://your-project.livekit.cloud"

# ─────────────────────────────────────────────────────────────────
# FREE APIs — NO KEY REQUIRED
# ─────────────────────────────────────────────────────────────────
# These services are used automatically with no configuration needed:
#
# - OpenFDA Drug API:       https://api.fda.gov/drug/          (drug interactions)
# - WHO ICD-11 API:         https://id.who.int/icd/            (diagnosis coding)
# - NCBI PubMed API:        https://eutils.ncbi.nlm.nih.gov/  (evidence citations)
# - OpenStreetMap Overpass: https://overpass-api.de/           (emergency hospitals)
# - WhatsApp Click-to-Chat: https://wa.me/                    (report sharing)
# - Web Push API:           Browser built-in                   (notifications)
#
# ─────────────────────────────────────────────────────────────────

# Next.js App URL (used for FHIR export absolute URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


